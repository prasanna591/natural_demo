DATABASE_URL=sqlite:///./naturals.db
JWT_SECRET=replace-this-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=1440
CORS_ORIGINS=*

# Database pool (PostgreSQL multi-worker deployments benefit most).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=15000

# Observability.
LOG_LEVEL=INFO
ACCESS_LOG_ENABLED=true
SLOW_QUERY_MS=200
# Optional bearer token for /metrics. Leave empty on a private network.
METRICS_TOKEN=

# In-process public response cache. Availability and user data are never cached.
CACHE_TTL_SECONDS=30
CACHE_TTL_LONG_SECONDS=60
CACHE_MAX_ENTRIES=2000

# Request rate limits per client IP per minute. Set RATE_LIMIT_ENABLED=false
# only for controlled load tests.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=1200
RATE_LIMIT_AUTH_PER_MINUTE=60
RATE_LIMIT_BOOKING_PER_MINUTE=120
RATE_LIMIT_AVAILABILITY_PER_MINUTE=300
RATE_LIMIT_ADMIN_PER_MINUTE=600
# Enable only when a trusted reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Startup behaviour. Run `python -m app.bootstrap` once, then disable worker
# migrations for multi-worker deployments.
RUN_STARTUP_MIGRATIONS=true
STARTUP_LOCK_TIMEOUT_SECONDS=120

# Optional staff accounts. Set both email and password to seed the account on startup.
# Passwords must be at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

DEVELOPER_EMAIL=
DEVELOPER_PASSWORD=
