EXPO_PUBLIC_API_URL=http://localhost:8000
# Android: the PC's LAN address (phones on the same Wi-Fi) or a public HTTPS URL.
# Emulator-only builds can use http://10.0.2.2:8000 to reach the host.
# The address below is this computer's current Wi-Fi IP; update it if the IP changes.
EXPO_PUBLIC_API_URL_ANDROID=http://10.92.221.240:8000

# Demo mode: any value other than "online" routes all requests through the
# in-app offline demo layer (no backend required at runtime).
EXPO_PUBLIC_DEMO_MODE=offline
